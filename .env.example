APP_ENV=development
APP_NAME=Structured Infrastructure Manager
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://sim_app:sim_app@postgres:5432/sim
PLATFORM_DATABASE_URL=postgresql+psycopg://sim_platform:sim_platform@postgres:5432/sim
MIGRATION_DATABASE_URL=postgresql+psycopg://sim_platform:sim_platform@postgres:5432/sim

# Browser/API boundary
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,X-Request-ID,X-Tenant-ID,X-Actor-ID,X-Project-ID,X-Location-ID,X-CSRF-Token
CORS_EXPOSE_HEADERS=Content-Disposition,X-Request-ID,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,X-Result-Count,X-Result-Total,X-Result-Truncated
CORS_ALLOW_CREDENTIALS=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
REQUIRE_HTTPS=false
TRUSTED_PROXY_IPS=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Identity: use demo only for local bootstrap. Production must use AUTH_MODE=oidc.
PLATFORM_BOOTSTRAP_KEY=replace-this-secret
DEMO_MODE=true
AUTH_MODE=hybrid
OIDC_ISSUER_URL=http://keycloak:8080/realms/sim
OIDC_AUDIENCE=sim-api
OIDC_JWKS_URL=
OIDC_JWKS_JSON=
OIDC_ALGORITHMS=RS256
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_JWKS_CACHE_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_TENANT_CLAIM=tenant_id
OIDC_ALLOW_VERIFIED_EMAIL_LINKING=false

# Request controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/api/v1/health,/api/v1/ready
RATE_LIMIT_DATABASE_URL=
RATE_LIMIT_KEY_SECRET=replace-rate-limit-secret
RATE_LIMIT_RETENTION_SECONDS=3600
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
RATE_LIMIT_FAIL_MODE=closed
COOKIE_AUTH_ENABLED=false
AUTH_COOKIE_NAME=sim_access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=sim_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Optional real PostgreSQL Forced-RLS proof
RLS_TEST_APPLICATION_DSN=
RLS_TEST_PLATFORM_DSN=

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_PATH=/data/storage

# Optional browser SSO: register /api/v1/auth/callback at your shared OIDC provider.
# Requires AUTH_MODE=oidc (or hybrid), COOKIE_AUTH_ENABLED=true, CORS_ALLOW_CREDENTIALS=true.
SSO_ENABLED=false
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
# Leave endpoint URLs blank to use issuer discovery.
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
# Generate a private random value of at least 32 characters; share across API replicas.
SSO_STATE_SECRET=
SSO_STATE_TTL_SECONDS=300
